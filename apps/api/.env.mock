# Mock configuration for portfolio/demo without real API keys
# Copy this to .env for mock mode: cp .env.mock .env

# OpenAI API Key - not needed in mock mode but required by config
OPENAI_API_KEY=mock-key-not-used

# Database - uses local PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/miniglean

# Environment
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# Enable mock mode (bypasses real OpenAI calls)
USE_MOCK_LLM=true

# Document limits
MAX_DOCUMENTS=20

# Chunking settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# AI models (not used in mock mode but required by config)
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0

# Retrieval settings
TOP_K_RESULTS=5

# Logging
LOG_LEVEL=DEBUG
