# OpenAI API Key
OPENAI_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miniglean

# Environment
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# Document limits
MAX_DOCUMENTS=20

# Chunking settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# AI models
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0

# Retrieval settings
TOP_K_RESULTS=5

# Logging
LOG_LEVEL=DEBUG
